# Copy to .env and adjust. All values are optional.

# Host port of the web UI (and the MCP endpoint at /mcp)
WEB_PORT=3300
# Must match WEB_PORT: used to build links returned to Claude via MCP
PUBLIC_URL=http://localhost:3300

POSTGRES_USER=workspace
POSTGRES_PASSWORD=workspace
POSTGRES_DB=workspace
# Host ports for local development tools (bound to 127.0.0.1 only)
POSTGRES_PORT=55432
REDIS_PORT=56379

MAX_UPLOAD_MB=25
MAX_MODEL_UPLOAD_MB=100
TREE_CACHE_TTL=10m
DEV_MODE=false

# The service has no authentication: keep it on localhost unless you add a proxy with auth.
# Set to 0.0.0.0 to expose it to your local network.
WEB_BIND=127.0.0.1
